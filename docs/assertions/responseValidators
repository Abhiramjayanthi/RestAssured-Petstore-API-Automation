given()
    .baseUri("https://petstore.swagger.io/v2")
    .pathParam("petId", id)
.when()
    .get("/pet/{petId}")
.then()
    .statusCode(200)
    .contentType("application/json")
    .body("id", equalTo(id))
    .body("name", notNullValue());


.body("customer.name", equalTo("Thomas"))
.body("customer.active", equalTo(true))
.body("items", hasSize(2))
.body("items.product", hasItems("Laptop", "Mouse"))
.body("items.price", everyItem(greaterThan(0)))
.body("items[0].product", equalTo("Laptop"));