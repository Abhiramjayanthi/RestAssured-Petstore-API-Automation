
{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",

      "status"

    ],
    "properties": {
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "available",
          "pending",
          "sold"
        ]
      },
      "photoUrls": {
        "type": "array",
        "items": {
          "type": ["string","null"]
        }
      }
    }
  }
}
