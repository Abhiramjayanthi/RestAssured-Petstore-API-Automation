
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": ["available", "pending", "sold"]
      },
      "photoUrls": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "id",
      "name",
      "status",
      "photoUrls"
    ]
  }
}
